# Copy to .env (optional). The launcher reads these; none are required.
# Your Anthropic API key. You can also enter it in Settings → AI Provider (stored in data/secrets.json, mode 0600).
ANTHROPIC_API_KEY=
# Model identifier (default: claude-opus-5-5). Changeable in Settings.
PS_MODEL=
# Where the database, files, exports and backups live (default: ./data)
PS_DATA_DIR=
# Local address (default 127.0.0.1:8765). Keep 127.0.0.1 unless you know what you are doing.
PS_HOST=127.0.0.1
PS_PORT=8765
# Maximum upload size per file in MB (default 25)
PS_MAX_UPLOAD_MB=25
# "anthropic" (default) or "mock" for a fully offline test mode with labelled placeholder output
PS_AI_PROVIDER=anthropic
